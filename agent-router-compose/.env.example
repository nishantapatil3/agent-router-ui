# Copy to .env and fill in LITELLM_API_KEY. docker compose reads .env automatically.

# Pin the Agent Router CLI image tag (see docker.io/envoyproxy/ai-gateway-cli).
AIGW_VERSION=latest

# The LiteLLM endpoint aigw routes to. Host and port only — the /v1 path comes
# from the incoming request. Port 443 implies HTTPS, which requires the
# BackendTLSPolicy in config/aigw.yaml to be enabled (it is, by default).
LITELLM_HOST=llm-proxy.prod.outshift.ai
LITELLM_PORT=443
# LiteLLM virtual key. aigw injects it upstream; clients never send it.
LITELLM_API_KEY=sk-your-litellm-virtual-key

# true tees the gateway's output — including Envoy's JSON access logs — to the
# container console, for `docker compose logs aigw`.
AIGW_DEBUG=false

# Web UI (ghcr.io/nishantapatil3/agent-router-ui) image tag and host port.
UI_VERSION=latest
UI_PORT=8080

GRAFANA_ADMIN_PASSWORD=admin
